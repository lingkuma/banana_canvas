# AI channel: gemini, openai-compatible, or doubao
AI_PROVIDER=openai-compatible

# Provider API root. OpenAI-compatible URLs normally end with /v1.
# Leave this empty for Google's official Gemini endpoint.
AI_BASE_URL=https://api.openai.com/v1

# Keep the real key only in .env. Never commit it.
AI_API_KEY=

# Default model selected for users who have not chosen one yet.
AI_MODEL=gpt-image-2

# Comma-separated models shown in the browser's model selector.
AI_MODELS=gpt-image-2,gemini-3.1-flash-image,gemini-3-pro-image

# Doubao Seedream channel (used when AI_PROVIDER=doubao).
# The API root should end with /api/v3.
BUILTIN_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BUILTIN_DOUBAO_API_KEY=
# Pro (2K max) and Lite (4K capable) models.
BUILTIN_DOUBAO_MODEL=doubao-seedream-5-0-260128
BUILTIN_DOUBAO_MODELS=doubao-seedream-5-0-260128,doubao-seedream-5-0-lite-260128,doubao-seedream-5-0-pro-260628

# Set true only when the OpenAI-compatible channel returns SSE streams.
AI_STREAM=false

# Internal server listening address.
HOST=0.0.0.0
PORT=3000

# Increase this if large source images make requests exceed the limit.
AI_MAX_REQUEST_SIZE=100mb
