# AI channel: gemini or openai-compatible
AI_PROVIDER=openai-compatible

# Provider API root. OpenAI-compatible URLs normally end with /v1.
# Leave this empty for Google's official Gemini endpoint.
AI_BASE_URL=https://api.openai.com/v1

# Keep the real key only in .env. Never commit it.
AI_API_KEY=

# The server controls the model used by every browser.
AI_MODEL=gpt-image-2

# Set true only when the OpenAI-compatible channel returns SSE streams.
AI_STREAM=false

# Internal server listening address.
HOST=0.0.0.0
PORT=3000

# Increase this if large source images make requests exceed the limit.
AI_MAX_REQUEST_SIZE=100mb
